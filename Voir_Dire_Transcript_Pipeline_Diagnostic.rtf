\pard\brdrb\brdrs\brdrw10\brdrcf5\sb100\sa200
{\f0\b\fs28\cf2 6. CORRUPTED DATA CHECK\par}
\pard\ql\sb0\sa100
{\f0\fs22 Run these SQL queries against the database to identify corrupted response records:\par}
\pard\li360\sb60\sa60
{\f0\fs20\f1 -- Find responses with NULL questionId that should have one (side='yours')\par
SELECT id, case_id, juror_number, question_id, response_text, side, recorded_by\par
FROM responses\par
WHERE side = 'yours' AND question_id IS NULL\par
ORDER BY timestamp DESC;\par
\par
-- Find responses where questionId doesn't match any question in the case\par
SELECT r.id, r.case_id, r.juror_number, r.question_id, r.response_text, r.recorded_by\par
FROM responses r\par
LEFT JOIN questions q ON q.case_id = r.case_id AND q.question_number = r.question_id\par
WHERE r.question_id IS NOT NULL AND q.id IS NULL\par
ORDER BY r.timestamp DESC;\par
\par
-- Count of responses per case with/without valid question linkage\par
SELECT r.case_id, c.name,\par
  COUNT(*) as total_responses,\par
  COUNT(CASE WHEN r.question_id IS NOT NULL AND q.id IS NOT NULL THEN 1 END) as linked,\par
  COUNT(CASE WHEN r.question_id IS NOT NULL AND q.id IS NULL THEN 1 END) as broken_link,\par
  COUNT(CASE WHEN r.question_id IS NULL AND r.side = 'yours' THEN 1 END) as missing_link\par
FROM responses r\par
LEFT JOIN questions q ON q.case_id = r.case_id AND q.question_number = r.question_id\par
LEFT JOIN cases c ON c.id = r.case_id\par
GROUP BY r.case_id, c.name;\par}
\pard\ql\sb0\sa0
{\f0\fs2\par}

